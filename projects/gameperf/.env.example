# Default is loopback-only development. Not a public deployment configuration.
GP_ORIGIN=http://localhost:8765
GP_PORT=8765
GP_COOKIE_SECURE=false
GP_IMAGE_TAG=0.3.0

# For production behind your existing HTTPS proxy, replace the values above:
# GP_ORIGIN=https://perf.your-domain.example
# GP_COOKIE_SECURE=true
# The optional Caddy TLS stack also requires:
# GP_DOMAIN=perf.your-domain.example

# Passwords, tokens, SSH keys and provider keys DO NOT belong in this file.
