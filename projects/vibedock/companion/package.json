{
  "name": "vibedock-companion",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local PC companion and round badge simulator for Codex and WorkBuddy",
  "engines": {"node": ">=22.13"},
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/server.mjs && node --check public/app.js",
    "probe:codex": "node scripts/probe-codex.mjs",
    "probe:status": "node scripts/probe-status.mjs",
    "hooks:install": "node scripts/install-codex-hook.mjs"
  }
}
